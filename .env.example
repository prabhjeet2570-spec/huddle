# Every setting is prefixed HUDDLE_ and read by app/config.py.
# Defaults are safe for local development; none of these are required to boot.

# --- Database --------------------------------------------------------------
HUDDLE_DATABASE_URL=postgresql+asyncpg://huddle:huddle@localhost:5433/huddle

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HUDDLE_JWT_SECRET=replace-with-a-long-random-secret
HUDDLE_JWT_EXPIRATION_HOURS=24

# --- Seed data -------------------------------------------------------------
HUDDLE_SEED_ON_STARTUP=true
HUDDLE_SEED_USER_PASSWORD=huddle-dev-password

# --- Language model --------------------------------------------------------
# openai | anthropic | fake  ("fake" runs a scripted model, no API key needed)
HUDDLE_LLM_PROVIDER=openai
HUDDLE_LLM_MODEL=gpt-4o-mini
HUDDLE_LLM_API_KEY=replace-with-your-api-key
# For Anthropic:
#   HUDDLE_LLM_PROVIDER=anthropic
#   HUDDLE_LLM_MODEL=claude-sonnet-5

# --- Holds -----------------------------------------------------------------
HUDDLE_HOLD_TTL_SECONDS=120
HUDDLE_HOLD_SWEEPER_INTERVAL_SECONDS=10

# --- Tool reliability ------------------------------------------------------
HUDDLE_TOOL_TIMEOUT_SECONDS=10
HUDDLE_TOOL_MAX_ATTEMPTS=3

# --- Guardrails ------------------------------------------------------------
HUDDLE_MAX_TOOL_CALLS_PER_CONVERSATION=25
HUDDLE_MAX_TOKENS_PER_CONVERSATION=60000

# --- Hold-cycling detection ------------------------------------------------
HUDDLE_ABUSE_WINDOW_SECONDS=1800
HUDDLE_ABUSE_MIN_HOLDS=4
HUDDLE_ABUSE_MAX_CONFIRM_RATIO=0.34
HUDDLE_ABUSE_RATE_LIMIT_SECONDS=900

# --- Observability ---------------------------------------------------------
HUDDLE_OTEL_ENABLED=false
HUDDLE_OTEL_ENDPOINT=http://localhost:4318
HUDDLE_OTEL_SERVICE_NAME=huddle-agent

# --- Testing ---------------------------------------------------------------
# Never enable outside tests. Arms the deterministic failure injector.
HUDDLE_FAILURE_INJECTION_ENABLED=false

# --- UI --------------------------------------------------------------------
HUDDLE_API_BASE_URL=http://localhost:8000
